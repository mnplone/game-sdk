{
	"name": "@mnplone/game-sdk",
	"version": "0.1.0-dev",
	"description": "SDK for M1 games.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=16.9"
	},
	"dependencies": {
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.5",
		"@kirick/lint": "^0.2.4",
		"@types/node": "^22.15.13",
		"eslint": "9.27.0",
		"oxlint": "1.3.0",
		"publint": "^0.3.12",
		"tsdown": "^0.10.0",
		"typescript": "5.9.0-beta",
		"unplugin-unused": "^0.4.4",
		"vitest": "3.1.3"
	},
	"scripts": {
		"build": "tsdown src/main.ts --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc # && (cd test && tsc)",
		"test": "exit 0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mnplone/game-sdk.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mnplone/game-sdk/issues"
	},
	"homepage": "https://github.com/mnplone/game-sdk#readme"
}
