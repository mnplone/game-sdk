{
	"name": "@mnplone/game-sdk",
	"version": "0.1.0-dev",
	"description": "SDK for M1 games.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.mjs",
	"types": "dist/main.d.mts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"valibot": "1.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.1",
		"@types/node": "22.15.13",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.22.1",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.7",
		"vitest": "4.1.7"
	},
	"scripts": {
		"build": "tsdown src/main.ts --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build",
		"lint": "biome format && oxlint && eslint . && tsc"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mnplone/game-sdk.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mnplone/game-sdk/issues"
	},
	"homepage": "https://github.com/mnplone/game-sdk#readme"
}
