{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"module": "preserve",
		"noEmit": true,
		"lib": ["es2023", "DOM"],
		"types": ["node"],
		"declaration": true,
		"isolatedDeclarations": false,
		"importHelpers": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/"],
	"exclude": ["**/*.test.ts"]
}
